// O site na Cloudflare: um Worker só com os arquivos do build (dist/).
// Publicado pelo workflow "Publicar" a cada push na main (npx wrangler deploy).
{
  "name": "sumula",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Rotas como /times/123 ou /simulador entregam o index.html e o React Router assume.
    "not_found_handling": "single-page-application"
  },
  // O site fica em brasumula.com.br e www.brasumula.com.br. A Cloudflare cria o DNS e o certificado sozinha.
  "routes": [
    { "pattern": "brasumula.com.br", "custom_domain": true },
    { "pattern": "www.brasumula.com.br", "custom_domain": true }
  ],
  // Mantém também o endereço sumula.brasumula.workers.dev.
  "workers_dev": true
}
